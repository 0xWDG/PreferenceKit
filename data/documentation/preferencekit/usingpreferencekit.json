{"sections":[],"primaryContentSections":[{"content":[{"anchor":"Add-a-settings-screen","text":"Add a settings screen","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Pass your app’s privacy policy, support email, changelog, acknowledgements, and"},{"type":"text","text":" "},{"type":"text","text":"social-media profiles to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/PreferenceKit"},{"type":"text","text":". Supply "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for an optional item"},{"type":"text","text":" "},{"type":"text","text":"to hide it. "},{"code":"changeLog","type":"codeVoice"},{"type":"text","text":" and "},{"code":"acknowledgements","type":"codeVoice"},{"type":"text","text":" are required parameters so the"},{"type":"text","text":" "},{"type":"text","text":"call site makes that choice explicit."}],"type":"paragraph"},{"code":["import SwiftUI","import PreferenceKit","","struct SettingsView: View {","    var body: some View {","        PreferenceKit(","            createdBy: \"[Example Studio](https:\/\/example.com)\",","            privacyPolicyURL: URL(string: \"https:\/\/example.com\/privacy\"),","            supportEmail: \"support@example.com\",","            socialMediaLinks: [","                .init(platform: .github, profile: \"example\"),","                .init(platform: .website, profile: \"https:\/\/example.com\")","            ],","            changeLog: [","                .init(version: \"1.0\", text: \"Initial release\")","            ],","            acknowledgements: [","                .init(","                    name: \"Example Dependency\",","                    copyright: \"Example Authors\",","                    licence: \"MIT\"","                )","            ],","            topContent: { EmptyView() },","            bottomContent: { EmptyView() }","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Configure-social-media-links","text":"Configure social-media links","type":"heading"},{"inlineContent":[{"text":"Create ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/SocialMediaLink","type":"reference"},{"text":" values with a service and a profile identifier.","type":"text"},{"text":" ","type":"text"},{"text":"PreferenceKit builds the destination URL for each supported service. A complete","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"HTTP or HTTPS URL is kept as-is, which is useful for invitation and workspace"},{"text":" ","type":"text"},{"type":"text","text":"links."}],"type":"paragraph"},{"syntax":"swift","code":["let links: [SocialMediaLink] = [","    .init(platform: .github, profile: \"example\"),","    .init(platform: .mastodon, profile: \"@example@mastodon.social\"),","    .init(platform: .discord, profile: \"https:\/\/discord.gg\/example\")","]"],"type":"codeListing"},{"level":2,"anchor":"Add-custom-sections","text":"Add custom sections","type":"heading"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"topContent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"bottomContent","type":"codeVoice"},{"text":" view builders to add app-specific","type":"text"},{"text":" ","type":"text"},{"text":"settings before or after PreferenceKit’s built-in sections.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["PreferenceKit(","    changeLog: nil,","    acknowledgements: nil",") {","    Section(\"Preferences\") {","        Toggle(\"Send diagnostics\", isOn: $sendsDiagnostics)","    }","} bottomContent: {","    Section {","        Text(\"Example App\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The top section appears after the update information and before the built-in"},{"text":" ","type":"text"},{"type":"text","text":"application details. The bottom section appears after developer links. Use"},{"type":"text","text":" "},{"type":"text","text":"standard SwiftUI controls, and provide their accessibility labels and hints as"},{"type":"text","text":" "},{"type":"text","text":"you would in any settings form."}],"type":"paragraph"},{"level":2,"anchor":"Supply-support-information","type":"heading","text":"Supply support information"},{"type":"paragraph","inlineContent":[{"text":"Setting ","type":"text"},{"code":"supportEmail","type":"codeVoice"},{"text":" adds a Feedback button. PreferenceKit gathers the","type":"text"},{"text":" ","type":"text"},{"text":"available log text before presenting the system mail composer. If the device","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"cannot send mail, it opens a prefilled "},{"code":"mailto:","type":"codeVoice"},{"text":" URL instead. Give users a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"support address that you monitor."}]},{"inlineContent":[{"code":"createdBy","type":"codeVoice"},{"type":"text","text":" supports Markdown, so you can credit a person or organization with"},{"type":"text","text":" "},{"type":"text","text":"a link:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["PreferenceKit(","    createdBy: \"[Example Studio](https:\/\/example.com)\",","    changeLog: nil,","    acknowledgements: nil,","    topContent: { EmptyView() },","    bottomContent: { EmptyView() }",")"]},{"anchor":"Privacy-policy-behavior","text":"Privacy policy behavior","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"privacyPolicyURL"},{"type":"text","text":" is present, PreferenceKit adds a Privacy Policy row."},{"type":"text","text":" "},{"type":"text","text":"On platforms and OS versions that support the packaged web view, selecting the"},{"type":"text","text":" "},{"type":"text","text":"row presents the policy in-app. Otherwise, it opens the policy in the system"},{"text":" ","type":"text"},{"text":"browser. The in-app reader also has a toolbar button that opens the same URL in","type":"text"},{"text":" ","type":"text"},{"text":"the system browser.","type":"text"}],"type":"paragraph"},{"anchor":"Privacy-permissions","text":"Privacy permissions","type":"heading","level":2},{"inlineContent":[{"text":"Privacy framework integrations are separated into opt-in package products:","type":"text"},{"text":" ","type":"text"},{"code":"PreferenceKitCamera","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PreferenceKitMicrophone","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PreferenceKitPhotos","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"PreferenceKitLocation","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PreferenceKitContacts","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PreferenceKitCalendar","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"PreferenceKitReminders","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PreferenceKitSpeechRecognition","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"PreferenceKitNotifications","type":"codeVoice"},{"text":". Import only products for protected APIs your app","type":"text"},{"text":" ","type":"text"},{"text":"uses, then pass their capability values through ","type":"text"},{"code":"privacyPermissions","type":"codeVoice"},{"text":"; this keeps","type":"text"},{"text":" ","type":"text"},{"text":"unused protected APIs out of the final app binary.","type":"text"}],"type":"paragraph"},{"code":["import PreferenceKit","import PreferenceKitCamera","","PreferenceKit(","    changeLog: nil,","    acknowledgements: nil,","    privacyPermissions: [.camera]",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"PreferenceKit checks the host app’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" only for capabilities supplied","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"privacyPermissions","type":"codeVoice"},{"text":". A selected Camera, Microphone, Photos, Location,","type":"text"},{"text":" ","type":"text"},{"text":"Contacts, Calendar, Reminders, or Speech Recognition capability appears when","type":"text"},{"text":" ","type":"text"},{"text":"its usage description is nonempty. When at least one selected capability is","type":"text"},{"text":" ","type":"text"},{"text":"available, PreferenceKit adds a Privacy destination that shows the declared","type":"text"},{"text":" ","type":"text"},{"text":"reason and, on supported platforms, a Change button that opens the relevant","type":"text"},{"text":" ","type":"text"},{"text":"Settings page. Notifications have no ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" usage-description key and","type":"text"},{"text":" ","type":"text"},{"text":"appear whenever ","type":"text"},{"code":".notifications","type":"codeVoice"},{"text":" is supplied. Each detail view reads and","type":"text"},{"text":" ","type":"text"},{"text":"displays the current authorization state without showing a permission prompt.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Add purpose strings to the consuming app target’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"not to PreferenceKit. App Store Connect analyzes the final app binary, so a"},{"type":"text","text":" "},{"type":"text","text":"linked privacy API can require its corresponding key even when the app has"},{"type":"text","text":" "},{"type":"text","text":"not requested access yet. Each value must truthfully explain the feature"},{"type":"text","text":" "},{"type":"text","text":"that uses the protected data."}],"type":"paragraph"}],"style":"important","type":"aside","name":"Important"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Capability"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Info.plist key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Example purpose string"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Camera"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSCameraUsageDescription"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"This app uses the camera to scan receipts."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Microphone"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSMicrophoneUsageDescription"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"This app uses the microphone to record voice notes."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Photos"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSPhotoLibraryUsageDescription"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"This app lets you attach photos to entries."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Location"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSLocationWhenInUseUsageDescription"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"This app uses your location to show nearby events."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Contacts"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSContactsUsageDescription"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"This app lets you choose contacts to invite."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Calendar"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSCalendarsFullAccessUsageDescription"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"This app adds events to your calendar."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Reminders"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSRemindersFullAccessUsageDescription"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"This app creates reminders for your tasks."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Speech Recognition"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NSSpeechRecognitionUsageDescription"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"This app transcribes spoken event titles."}],"type":"paragraph"}]]]},{"inlineContent":[{"code":"PreferenceKitNotifications","type":"codeVoice"},{"text":" does not require a purpose string. Include it only","type":"text"},{"text":" ","type":"text"},{"text":"when your app requests or presents notification authorization.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Add ","type":"text"},{"code":"NSMicrophoneUsageDescription","type":"codeVoice"},{"text":" as well when speech recognition captures","type":"text"},{"text":" ","type":"text"},{"text":"live audio. Localize these strings with the app target’s ","type":"text"},{"code":"InfoPlist.strings","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Do not add a generic or inaccurate value solely to silence App Store Connect;","type":"text"},{"text":" ","type":"text"},{"text":"remove the sensitive API from the final app instead when the feature is not","type":"text"},{"text":" ","type":"text"},{"text":"offered.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To add app-specific privacy information, use the ","type":"text"},{"code":"privacyContent","type":"codeVoice"},{"text":" result","type":"text"},{"text":" ","type":"text"},{"text":"builder. Supply a single row, ","type":"text"},{"code":"Section","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"Group","type":"codeVoice"},{"text":"; custom content also makes","type":"text"},{"text":" ","type":"text"},{"text":"the Privacy destination available when the app has no detected permissions.","type":"text"}],"type":"paragraph"},{"code":["PreferenceKit(","    changeLog: nil,","    acknowledgements: nil,","    privacyContent: {","        Section(\"Privacy choices\") {","            NavigationLink(\"Data controls\") {","                Text(\"Choose how Example App uses your data.\")","            }","        }","    }",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Next-steps","text":"Next steps","type":"heading","level":2},{"inlineContent":[{"text":"For supported profile formats and the public configuration models, see","type":"text"},{"text":" ","type":"text"},{"text":"doc:Configuration","type":"text"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/UsingPreferenceKit"},"metadata":{"roleHeading":"Article","title":"Using PreferenceKit","modules":[{"name":"PreferenceKit"}],"role":"article"},"kind":"article","variants":[{"paths":["\/documentation\/preferencekit\/usingpreferencekit"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/PreferenceKit\/documentation\/PreferenceKit"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Create a settings screen by configuring "},{"type":"reference","identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/PreferenceKit","isActive":true},{"type":"text","text":" with your app’s"},{"type":"text","text":" "},{"type":"text","text":"support and legal information."}],"references":{"doc://PreferenceKit/documentation/PreferenceKit/SocialMediaLink":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SocialMediaLink","kind":"identifier"}],"abstract":[{"type":"text","text":"A link to a social media profile displayed in "},{"code":"PreferenceKit","type":"codeVoice"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"SocialMediaLink","kind":"identifier"}],"title":"SocialMediaLink","type":"topic","kind":"symbol","identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/SocialMediaLink","url":"\/documentation\/preferencekit\/socialmedialink","role":"symbol"},"doc://PreferenceKit/documentation/PreferenceKit/PreferenceKit":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PreferenceKit"}],"identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/PreferenceKit","role":"symbol","title":"PreferenceKit","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PreferenceKit"}],"abstract":[{"type":"text","text":"PreferenceKit Settings View"}],"type":"topic","url":"\/documentation\/preferencekit\/preferencekit"},"doc://PreferenceKit/documentation/PreferenceKit":{"type":"topic","identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit","url":"\/documentation\/preferencekit","kind":"symbol","abstract":[{"type":"text","text":"Build a consistent SwiftUI settings screen with support, legal, and developer"},{"type":"text","text":" "},{"type":"text","text":"information."}],"title":"PreferenceKit","role":"collection"}}}