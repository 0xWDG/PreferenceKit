{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Create a settings screen by configuring "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/PreferenceKit"},{"type":"text","text":" with your app’s"},{"type":"text","text":" "},{"type":"text","text":"support and legal information."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Add a settings screen","level":2,"anchor":"Add-a-settings-screen"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass your app’s privacy policy, support email, changelog, acknowledgements, and"},{"type":"text","text":" "},{"type":"text","text":"social-media profiles to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/PreferenceKit"},{"type":"text","text":". Supply "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for an optional item"},{"type":"text","text":" "},{"type":"text","text":"to hide it. "},{"type":"codeVoice","code":"changeLog"},{"type":"text","text":" and "},{"type":"codeVoice","code":"acknowledgements"},{"type":"text","text":" are required parameters so the"},{"type":"text","text":" "},{"type":"text","text":"call site makes that choice explicit."}]},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import PreferenceKit","","struct SettingsView: View {","    var body: some View {","        PreferenceKit(","            createdBy: \"[Example Studio](https:\/\/example.com)\",","            privacyPolicyURL: URL(string: \"https:\/\/example.com\/privacy\"),","            supportEmail: \"support@example.com\",","            socialMediaLinks: [","                .init(platform: .github, profile: \"example\"),","                .init(platform: .website, profile: \"https:\/\/example.com\")","            ],","            changeLog: [","                .init(version: \"1.0\", text: \"Initial release\")","            ],","            acknowledgements: [","                .init(","                    name: \"Example Dependency\",","                    copyright: \"Example Authors\",","                    licence: \"MIT\"","                )","            ],","            topContent: { EmptyView() },","            bottomContent: { EmptyView() }","        )","    }","}"]},{"type":"heading","text":"Configure social-media links","level":2,"anchor":"Configure-social-media-links"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"type":"reference","identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/SocialMediaLink","isActive":true},{"text":" values with a service and a profile identifier.","type":"text"},{"text":" ","type":"text"},{"text":"PreferenceKit builds the destination URL for each supported service. A complete","type":"text"},{"text":" ","type":"text"},{"text":"HTTP or HTTPS URL is kept as-is, which is useful for invitation and workspace","type":"text"},{"text":" ","type":"text"},{"text":"links.","type":"text"}]},{"code":["let links: [SocialMediaLink] = [","    .init(platform: .github, profile: \"example\"),","    .init(platform: .mastodon, profile: \"@example@mastodon.social\"),","    .init(platform: .discord, profile: \"https:\/\/discord.gg\/example\")","]"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Add custom sections","anchor":"Add-custom-sections","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"code":"topContent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"bottomContent","type":"codeVoice"},{"type":"text","text":" view builders to add app-specific"},{"type":"text","text":" "},{"type":"text","text":"settings before or after PreferenceKit’s built-in sections."}],"type":"paragraph"},{"code":["PreferenceKit(","    changeLog: nil,","    acknowledgements: nil",") {","    Section(\"Preferences\") {","        Toggle(\"Send diagnostics\", isOn: $sendsDiagnostics)","    }","} bottomContent: {","    Section {","        Text(\"Example App\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The top section appears after the update information and before the built-in"},{"type":"text","text":" "},{"type":"text","text":"application details. The bottom section appears after developer links. Use"},{"type":"text","text":" "},{"type":"text","text":"standard SwiftUI controls, and provide their accessibility labels and hints as"},{"type":"text","text":" "},{"type":"text","text":"you would in any settings form."}],"type":"paragraph"},{"level":2,"text":"Supply support information","anchor":"Supply-support-information","type":"heading"},{"inlineContent":[{"text":"Setting ","type":"text"},{"type":"codeVoice","code":"supportEmail"},{"text":" adds a Feedback button. PreferenceKit gathers the","type":"text"},{"text":" ","type":"text"},{"text":"available log text before presenting the system mail composer. If the device","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"cannot send mail, it opens a prefilled "},{"type":"codeVoice","code":"mailto:"},{"text":" URL instead. Give users a","type":"text"},{"text":" ","type":"text"},{"text":"support address that you monitor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"createdBy"},{"type":"text","text":" supports Markdown, so you can credit a person or organization with"},{"type":"text","text":" "},{"type":"text","text":"a link:"}],"type":"paragraph"},{"syntax":"swift","code":["PreferenceKit(","    createdBy: \"[Example Studio](https:\/\/example.com)\",","    changeLog: nil,","    acknowledgements: nil,","    topContent: { EmptyView() },","    bottomContent: { EmptyView() }",")"],"type":"codeListing"},{"text":"Privacy policy behavior","anchor":"Privacy-policy-behavior","level":2,"type":"heading"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"privacyPolicyURL","type":"codeVoice"},{"text":" is present, PreferenceKit adds a Privacy Policy row.","type":"text"},{"text":" ","type":"text"},{"text":"On platforms and OS versions that support the packaged web view, selecting the","type":"text"},{"text":" ","type":"text"},{"text":"row presents the policy in-app. Otherwise, it opens the policy in the system","type":"text"},{"text":" ","type":"text"},{"text":"browser. The in-app reader also has a toolbar button that opens the same URL in","type":"text"},{"text":" ","type":"text"},{"text":"the system browser.","type":"text"}],"type":"paragraph"},{"text":"Next steps","anchor":"Next-steps","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"For supported profile formats and the public configuration models, see"},{"type":"text","text":" "},{"type":"text","text":"doc:Configuration"},{"type":"text","text":"."}],"type":"paragraph"}]}],"sections":[],"identifier":{"url":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/UsingPreferenceKit","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/preferencekit\/usingpreferencekit"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/PreferenceKit\/documentation\/PreferenceKit"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"PreferenceKit"}],"role":"article","title":"Using PreferenceKit"},"references":{"doc://PreferenceKit/documentation/PreferenceKit/PreferenceKit":{"type":"topic","identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/PreferenceKit","kind":"symbol","url":"\/documentation\/preferencekit\/preferencekit","title":"PreferenceKit","navigatorTitle":[{"text":"PreferenceKit","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"PreferenceKit Settings View"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"PreferenceKit","kind":"identifier"}]},"doc://PreferenceKit/documentation/PreferenceKit":{"type":"topic","identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit","kind":"symbol","url":"\/documentation\/preferencekit","title":"PreferenceKit","role":"collection","abstract":[{"type":"text","text":"Build a consistent SwiftUI settings screen with support, legal, and developer"},{"type":"text","text":" "},{"type":"text","text":"information."}]},"doc://PreferenceKit/documentation/PreferenceKit/SocialMediaLink":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SocialMediaLink"}],"url":"\/documentation\/preferencekit\/socialmedialink","kind":"symbol","type":"topic","identifier":"doc:\/\/PreferenceKit\/documentation\/PreferenceKit\/SocialMediaLink","abstract":[{"text":"A link to a social media profile displayed in ","type":"text"},{"type":"codeVoice","code":"PreferenceKit"},{"type":"text","text":"."}],"title":"SocialMediaLink","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SocialMediaLink"}]}}}